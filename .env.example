PORT=3000
NODE_ENV=production

# Storage mode: 'postgres' (default when DATABASE_URL is set) or 'json'
SAMAAN_STORAGE_MODE=postgres
# PostgreSQL connection string (used by node-postgres / pg)
DATABASE_URL=postgres://samaan:samaan@postgres:5432/samaan
# Optional PostgreSQL pool / SSL settings
PG_POOL_MAX=20
PGSSLMODE=
# Directory for extracted binary attachments (item photos, package photos, signed PDF scans)
SAMAAN_UPLOADS_DIR=/app/uploads

# Authentication & Encryption Security
# 32+ character high-entropy secret used for AES-256-GCM encryption of TOTP 2FA secrets and HMAC OTP hashing
AUTH_ENCRYPTION_KEY=
# Strict CORS origin(s), comma-separated (defaults to https://samaanapp.ir in production)
CORS_ORIGIN=https://samaanapp.ir

# Pre-Defined Superuser Account (seeded idempotently on server startup; never hardcoded in source)
SUPERUSER_FIRST_NAME=مدیر
SUPERUSER_LAST_NAME=سامانه
SUPERUSER_PHONE=
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=

# Iranian Shared-Pattern OTP SMS Provider: mock | smsir | kavenegar
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_TEMPLATE_ID=

# Optional AI & Developer Notification Integrations
GEMINI_API_KEY=
DEVELOPER_NOTIFY_EMAIL=
RESEND_API_KEY=
MAIL_FROM=
